import streamlit as st
import pandas as pd
import plotly.express as px

# Load data
df = pd.read_csv("social_media_data.csv")

# Title
st.title("📊 Social Media Trends & Sentiment Dashboard")

# Sentiment count
st.subheader("Sentiment Distribution")
sentiment_count = df['Sentiment'].value_counts()
st.bar_chart(sentiment_count)

# Platform filter
platforms = df['Platform'].unique()
selected_platform = st.multiselect("Select Platform(s):", platforms, default=platforms)

filtered_df = df[df['Platform'].isin(selected_platform)]

# Line chart of posts over time
st.subheader("Posts Over Time")
df['Date'] = pd.to_datetime(df['Timestamp'], dayfirst=True)
time_data = filtered_df.groupby(df['Date'].dt.date).size().reset_index(name='Posts')
fig_time = px.line(time_data, x='Date', y='Posts', title='Posts per Day')
st.plotly_chart(fig_time)

# Likes vs Retweets
st.subheader("Likes vs Retweets by Platform")
fig = px.scatter(filtered_df, x='Retweets', y='Likes', color='Platform', hover_data=['User', 'Text'])
st.plotly_chart(fig)

# Top Hashtags
st.subheader("Top Hashtags")
hashtags_series = df['Hashtags'].dropna().str.split().explode()
top_hashtags = hashtags_series.value_counts().head(10)
st.bar_chart(top_hashtags)
